+
+const tDe = (key, opts = {}) => {
+  const map = {
+    toastBidOutbidTitle: 'Ihr Gebot wurde überboten',
+    regionSpain: 'Spanien',
+    regionMadrid: 'Madrid',
+    notificationTitle_verificationSuccess: 'Verifizierung bestanden',
+  }
+  return map[key] || opts.defaultValue || key
+}
