{
  "name": "real-estate-auction",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:all": "concurrently --names \"SERVER,VITE\" --prefix-colors \"blue,green\" \"npm run server\" \"npm run dev\"",
    "dev:force": "node node_modules/vite/bin/vite.js --force",
    "clean:vite": "node scripts/clean-vite.mjs",
    "dev:clean": "npm run clean:vite && npm run dev:force",
    "prebuild": "node scripts/create-env.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "server": "node server/server.js",
    "server:dev": "node --watch server/server.js",
    "postinstall": "prisma generate",
    "prestart": "node scripts/prisma-startup.mjs",
    "start": "node server/server.js",
    "start:local": "echo '🚀 Запуск приложения локально...' && concurrently --restart-tries 3 --restart-after 2000 --kill-others-on-fail=false --names \"SERVER,FRONTEND\" --prefix-colors \"blue,green\" --prefix \"[{name}]\" \"npm run server\" \"npm run dev\"",
    "delete-user": "node delete-user-by-id.js",
    "clear-properties": "node clear-properties.js",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "load:test": "node scripts/load-test.js",
    "puppeteer:install": "npx puppeteer browsers install chrome",
    "import:housetenerife": "node scripts/import-housetenerife.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.59.2",
    "@emailjs/browser": "^4.4.1",
    "@emailjs/nodejs": "^5.0.2",
    "@motionone/utils": "^10.18.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.4.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-oauth/google": "^0.13.4",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.2.0",
    "@tonconnect/ui-react": "^2.4.2",
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "face-api.js": "^0.22.2",
    "framer-motion": "^12.35.0",
    "gsap": "^3.15.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.11.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.17.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "puppeteer": "^24.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^14.1.3",
    "react-icons": "^5.5.0",
    "react-is": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.8.0",
    "sql.js": "^1.10.3",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^5.0.8",
    "whatsapp-web.js": "^1.34.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.9.19",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.6.3"
  }
}
