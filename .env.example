# Скопируйте в .env и заполните. Файл .env не коммитьте.

# --- AI: чат, генерация описаний, новости (POST /api/ai/intelligence-chat) ---
# По умолчанию без ключа — Pollinations (бесплатно для тестов, ~1 запрос / 15 с):
AI_PROVIDER=pollinations
# AI_CHAT_MODEL=openai
#
# Лучшее качество / лимиты — OpenRouter (бесплатные модели, ключ на https://openrouter.ai/keys):
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
#
# Альтернатива: Groq (https://console.groq.com/keys)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
#
# Старый intelligence.io (если снова понадобится):
# AI_PROVIDER=intelligence
# INTELLIGENCE_IO_API_KEY=io-v2-...
#
# После изменения перезапустите сервер (npm start). Фронт ключ не хранит.

# --- Панель маркетолога (/marketer) и генерация новостей ---
# MARKETER_LOGIN=manager
# MARKETER_PASSWORD=manager
# UNSPLASH_ACCESS_KEY=   # опционально: поиск обложки по запросу ИИ

# PostgreSQL для Prisma
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newsellyourbrick?schema=public

# Stripe (тест): Dashboard → Developers → API keys (Test mode)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Продукт Pro: в Dashboard цена должна быть в EUR → скопируйте Price ID (price_...)
STRIPE_PRICE_ID_PRO=price_xxxxxxxx
# Deposit (кошелёк): price_... (цена) или prod_... (продукт — возьмётся первая активная подписка)
STRIPE_PRICE_ID_DEPOSIT=price_xxxxxxxx

# Куда вернуть пользователя после оплаты (локально Vite = 5173)
FRONTEND_URL=http://localhost:5173

# Webhook: Stripe Dashboard → Developers → Webhooks → Signing secret (whsec_...)
# Нужен для POST /api/webhooks/stripe с проверкой подписи
STRIPE_WEBHOOK_SECRET=

# EmailJS — общие ключи (как для кода подтверждения). Для писем из CRM лучше отдельный шаблон:
# EMAILJS_SERVICE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_CRM_TEMPLATE_ID=
# Шаблон ТОЛЬКО для писем из CRM (обязателен; общий шаблон кода регистрации сюда не подставляется).
# VITE_EMAILJS_CRM_TEMPLATE_ID=   и/или на сервере EMAILJS_CRM_TEMPLATE_ID → /api/config → emailjsCrmTemplateId
# В шаблоне задайте поля: to_email, subject, message (или body), from_name
#
# --- Обязательно для отправки с Node (CRM, напоминания об аукционе) ---
# 1) Включите в кабинете: https://dashboard.emailjs.com/admin/account/security
#    опцию «Allow EmailJS API for non-browser applications». Без неё запросы с сервера
#    дают 403, даже если задан EMAILJS_PRIVATE_KEY.
# 2) Private key (рекомендуется): https://dashboard.emailjs.com/admin → API keys
# EMAILJS_PRIVATE_KEY=
# Допустимы те же значения: EMAILJS_ACCESS_TOKEN или EMAILJS_PRIVATE_API_KEY

# --- Docker Compose (локально/на VPS) ---
# Если используете docker-compose.yml, можно оставить значения по умолчанию.
# При необходимости переопределите:
# POSTGRES_DB=newsellyourbrick
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_PORT=5432
