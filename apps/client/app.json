{
  "expo": {
    "name": "SellYourBrick",
    "slug": "sellyourbrick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sellyourbrick",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sellyourbrick.app"
    },
    "android": {
      "package": "com.sellyourbrick.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sellyourbrick.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "sellyourbrick",
              "host": "*",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://newsellyourbrick-production-6ed8.up.railway.app/api",
      "mediaOrigin": "https://newsellyourbrick-production-6ed8.up.railway.app",
      "eas": {
        "projectId": "sellyourbrick-local"
      }
    }
  }
}
