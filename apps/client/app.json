{
  "expo": {
    "name": "SellYourBrick",
    "slug": "sellyourbrick",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sellyourbrick",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sellyourbrick.app"
    },
    "android": {
      "package": "com.sellyourbrick.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sellyourbrick.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "sellyourbrick",
              "host": "*",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "@clerk/expo",
      "@clerk/expo-google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#00A6A6",
          "defaultChannel": "transactions"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://newsellyourbrick-production-6ed8.up.railway.app/api",
      "mediaOrigin": "https://newsellyourbrick-production-6ed8.up.railway.app",
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "1028494020168-034f525smlhane9lc4fo41bbugokjt1i.apps.googleusercontent.com",
      "eas": {
        "projectId": "40a04dbe-f0b1-44af-a294-e184520ae46e"
      },
      "router": {}
    },
    "owner": "vlad_teta"
  }
}
