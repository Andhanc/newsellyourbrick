  owner_notification_id Int?
  created_at            DateTime? @default(now())
  users                 users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_tdb_status")
  @@index([user_id], map: "idx_tdb_user")
  @@index([property_id, property_table], map: "idx_tdb_property")
}

model transactions {
  id          Int       @id @default(autoincrement())
  user_id     Int
  type        String
  amount      Float
  description String?
  created_at  DateTime? @default(now())
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_transactions_created_at")
  @@index([type], map: "idx_transactions_type")
  @@index([user_id], map: "idx_transactions_user_id")
}

model users {
  id                            Int                             @id @default(autoincrement())
  first_name                    String
  last_name                     String?
  email                         String?
  password                      String?
  phone_number                  String?                         @unique(map: "sqlite_autoindex_users_1")
  passport_series               String?
  passport_number               String?
  identification_number         String?
  address                       String?
  country                       String?
  passport_photo                String?
  user_photo                    String?
  is_verified                   Int?                            @default(0)
  role                          String?                         @default("buyer")
  is_online                     Int?                            @default(0)
  is_blocked                    Int?                            @default(0)
  created_at                    DateTime?                       @default(now())
  updated_at                    DateTime?                       @default(now())
  has_card                      Int?                            @default(0)
  deposit_amount                Float?                          @default(0)
  card_number                   String?
  card_type                     String?
  card_cvv                      String?
  user_id_number                String?
  telegram_id                   String?
  telegram_username             String?
  telegram_photo_url            String?
  username                      String?
  assistant_leads               assistant_leads[]
  live_chat_sessions            live_chat_sessions[]
  auction_winners               auction_winners[]
  bids                          bids[]
  bonus_task_submissions        bonus_task_submissions[]
  crm_leads                     crm_leads[]
  documents                     documents[]
  notifications                 notifications[]
  properties                    properties[]
  properties_apartments         properties_apartments[]
  properties_houses             properties_houses[]
  property_favorites            property_favorites[]
  property_shares               property_shares[]
  share_purchase_signature_intents share_purchase_signature_intents[]
  stripe_payments               stripe_payments[]
  stripe_subscription_state     stripe_subscription_state?
  stripe_wallet_deposit_credits stripe_wallet_deposit_credits[] @ignore
  test_drive_bookings           test_drive_bookings[]
  transactions                  transactions[]

  @@index([username], map: "idx_users_username")
  @@index([telegram_id], map: "idx_users_telegram_id")
  @@index([user_id_number], map: "idx_users_id_number")
  @@index([has_card], map: "idx_users_has_card")
  @@index([is_blocked], map: "idx_users_is_blocked")
  @@index([role], map: "idx_users_role")
  @@index([phone_number], map: "idx_users_phone")
  @@index([email], map: "idx_users_email")
}

model whatsapp_users {
  id                 Int       @id @default(autoincrement())
  phone_number       String    @unique(map: "sqlite_autoindex_whatsapp_users_1")
  phone_number_clean String?
  first_name         String?
  last_name          String?
  country            String?
  language           String?   @default("ru")
  last_message_at    DateTime?
  message_count      Int?      @default(0)
  is_active          Int?      @default(1)
  created_at         DateTime? @default(now())
  updated_at         DateTime? @default(now())
  lead_type          String?   @default("cold")

  @@index([last_message_at], map: "idx_whatsapp_users_last_message_at")
  @@index([is_active], map: "idx_whatsapp_users_is_active")
  @@index([country], map: "idx_whatsapp_users_country")
  @@index([phone_number_clean], map: "idx_whatsapp_users_phone_clean")
  @@index([phone_number], map: "idx_whatsapp_users_phone")
}

model live_chat_sessions {
  id                    Int                  @id @default(autoincrement())
  public_token          String               @unique(map: "sqlite_autoindex_live_chat_sessions_1")
  user_id               Int?
  assistant_session_id  String?
  display_label         String?
  created_at            DateTime?            @default(now())
  updated_at            DateTime?            @default(now())
  users                 users?               @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  live_chat_messages    live_chat_messages[]

  @@index([assistant_session_id], map: "idx_live_chat_sessions_assistant")
  @@index([updated_at], map: "idx_live_chat_sessions_updated")
}

model live_chat_messages {
  id                 Int     @id @default(autoincrement())
  session_id         Int
  sender_role        String
  body               String
  created_at         DateTime? @default(now())
  live_chat_sessions live_chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id, id], map: "idx_live_chat_messages_session")
}
