generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model administrators {
  id                           Int              @id @default(autoincrement())
  username                     String           @unique(map: "sqlite_autoindex_administrators_1")
  password                     String
  email                        String?
  full_name                    String?
  is_super_admin               Int?             @default(0)
  can_access_statistics        Int?             @default(0)
  can_access_users             Int?             @default(0)
  can_access_moderation        Int?             @default(0)
  can_access_chat              Int?             @default(0)
  can_access_objects           Int?             @default(0)
  can_access_access_management Int?             @default(0)
  created_by                   Int?
  created_at                   DateTime?        @default(now())
  updated_at                   DateTime?        @default(now())
  administrators               administrators?  @relation("administratorsToadministrators", fields: [created_by], references: [id], onUpdate: NoAction)
  other_administrators         administrators[] @relation("administratorsToadministrators")

  @@index([email], map: "idx_administrators_email")
  @@index([is_super_admin], map: "idx_administrators_is_super_admin")
  @@index([username], map: "idx_administrators_username")
}

model assistant_leads {
  id                        Int         @id @default(autoincrement())
  session_id                String      @unique(map: "sqlite_autoindex_assistant_leads_1")
  user_id                   Int?
  messages                  String?
  preferences               String?
  summary                   String?
  lead_type                 String?     @default("cold")
  email                     String?
  phone                     String?
  country                   String?
  region                    String?
  property_type             String?
  created_at                String?     @default("datetime('now')")
  updated_at                String?     @default("datetime('now')")
  manager_contact_requested Int?        @default(0)
  preferred_contact         String?
  users                     users?      @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  crm_leads                 crm_leads[]

  @@index([updated_at], map: "idx_assistant_leads_updated_at")
  @@index([lead_type], map: "idx_assistant_leads_lead_type")
  @@index([session_id], map: "idx_assistant_leads_session_id")
}

model auction_winners {
  id                 Int     @id @default(autoincrement())
  user_id            Int
  property_id        Int
  property_table     String
  winning_bid_amount Float
  currency           String? @default("USD")
  auction_end_date   String
  won_at             String? @default("datetime('now')")
  deposit_amount     Float
  deposit_due_date   String
  deposit_paid       Int?    @default(0)
  deposit_paid_at    String?
  status             String? @default("pending_deposit")
  created_at         String? @default("datetime('now')")
  updated_at         String? @default("datetime('now')")
  users              users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deposit_paid], map: "idx_auction_winners_deposit_paid")
  @@index([status], map: "idx_auction_winners_status")
  @@index([property_id], map: "idx_auction_winners_property_id")
  @@index([user_id], map: "idx_auction_winners_user_id")
}

model bids {
  id             Int       @id @default(autoincrement())
  user_id        Int
  property_id    Int
  property_table String?
  bid_amount     Float
  created_at     DateTime? @default(now())
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([property_id, property_table], map: "idx_bids_property_id_table")
  @@index([user_id, property_id], map: "idx_bids_user_property")
  @@index([created_at], map: "idx_bids_created_at")
  @@index([property_id], map: "idx_bids_property_id")
  @@index([user_id], map: "idx_bids_user_id")
}

model auction_reminders {
  id                           Int     @id @default(autoincrement())
  user_id                      Int
  property_id                  Int
  property_table               String
  notify_email                 Int?    @default(1)
  notify_whatsapp              Int?    @default(0)
  scheduled_at                 String
  auction_start_at             String?
  reminder_sent_at             String?
  auction_started_sent_at      String?
  circular_started_notified_at String?
  property_title               String?
  created_at                   String? @default("datetime('now')")
  updated_at                   String? @default("datetime('now')")

  @@unique([user_id, property_id, property_table], map: "sqlite_autoindex_auction_reminders_1")
  @@index([reminder_sent_at, scheduled_at], map: "idx_auction_reminders_scheduled")
  @@index([auction_started_sent_at, auction_start_at], map: "idx_auction_reminders_started")
}

model bonus_task_submissions {
  id          Int       @id @default(autoincrement())
  user_id     Int
  task_id     Int
  link        String
  status      String    @default("pending")
  promo_code  String?
  created_at  DateTime? @default(now())
  reviewed_at DateTime?
  used_at     DateTime?
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id], map: "idx_bonus_submissions_task_id")
  @@index([status], map: "idx_bonus_submissions_status")
  @@index([user_id], map: "idx_bonus_submissions_user_id")
}

model crm_activities {
  id         Int       @id @default(autoincrement())
  lead_id    Int
  kind       String
  title      String?
  body       String?
  meta       String?
  created_by String?
  created_at String?   @default("datetime('now')")
  crm_leads  crm_leads @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lead_id], map: "idx_crm_activities_lead")
}

model crm_leads {
  id                Int              @id @default(autoincrement())
  user_id           Int?
  display_name      String
  email             String?
  phone             String?
  stage_id          Int
  sort_order        Int              @default(0)
  temperature       String?          @default("warm")
  interests         String?
  deal_value        Float?
  currency          String?          @default("EUR")
  next_action       String?
  next_action_at    String?
  internal_notes    String?
  source            String?
  assistant_lead_id Int?
  created_at        String?          @default("datetime('now')")
  updated_at        String?          @default("datetime('now')")
  crm_activities    crm_activities[]
  assistant_leads   assistant_leads? @relation(fields: [assistant_lead_id], references: [id], onUpdate: NoAction)
  crm_stages        crm_stages       @relation(fields: [stage_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?           @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id], map: "idx_crm_leads_user")
  @@index([stage_id, sort_order], map: "idx_crm_leads_stage")
}

model crm_stages {
  id         Int         @id @default(autoincrement())
  slug       String      @unique(map: "sqlite_autoindex_crm_stages_1")
  label      String
  sort_order Int         @default(0)
  crm_leads  crm_leads[]
}

model debt_reasons {
  id         Int       @id @default(autoincrement())
  title_ru   String
  code       String?   @unique(map: "sqlite_autoindex_debt_reasons_1")
  sort_order Int?      @default(0)
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())

  @@index([sort_order], map: "idx_debt_reasons_sort")
}

model documents {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  document_type       String?
  document_photo      String
  is_reviewed         Int?      @default(0)
  verification_status String?   @default("pending")
  reviewed_by         String?
  reviewed_at         DateTime?
  rejection_reason    String?
  created_at          DateTime? @default(now())
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, verification_status], map: "idx_documents_user_status")
  @@index([verification_status], map: "idx_documents_verification_status")
  @@index([user_id], map: "idx_documents_user_id")
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String
  title      String
  message    String?
  data       String?
  is_read    Int?      @default(0)
  view_count Int?      @default(0)
  created_at DateTime? @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read], map: "idx_notifications_user_read")
  @@index([created_at], map: "idx_notifications_created_at")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([user_id], map: "idx_notifications_user_id")
}

